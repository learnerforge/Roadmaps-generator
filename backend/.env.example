# App
APP_NAME=PathForge AI
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pathforge

# Auth
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Supabase (optional - for OAuth)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI - Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI - OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
