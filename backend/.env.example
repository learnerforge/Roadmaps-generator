# =============================================================================
# NOTE: Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit secrets.
# =============================================================================

# App
APP_NAME=PathForge AI
DEBUG=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database
# Replace with your actual PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pathforge

# Auth
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# AI - Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI - OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Social OAuth
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Rate limiting (defaults — tune for your scale)
AI_CALLS_PER_DAY_FREE=5
AI_CALLS_PER_DAY_REGISTERED=20
AI_CALLS_PER_DAY_PREMIUM=999

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
